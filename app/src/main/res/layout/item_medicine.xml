<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="start|center_vertical"
        android:background="#E3F2FD"> <!-- ✅ light blue background -->

        <!-- Medicine Name -->
        <TextView
            android:id="@+id/textMedicineName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Medicine Dosage -->
        <TextView
            android:id="@+id/textMedicineDosage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dosage"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="4dp" />

        <!-- Medicine Time -->
        <TextView
            android:id="@+id/textMedicineTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="4dp" />

        <!-- Medicine Stock -->
        <TextView
            android:id="@+id/textMedicineStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="16dp" />

        <!-- Edit and Delete buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/textEditMedicine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="14sp"
                android:paddingEnd="16dp"
                android:drawableEnd="@drawable/ic_edit"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/textDeleteMedicine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="14sp"
                android:drawableEnd="@drawable/ic_delete"
                android:drawablePadding="8dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
